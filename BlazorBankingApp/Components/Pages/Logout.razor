@page "/logout"
@rendermode InteractiveServer
@using Supabase
@using Npgsql
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager NavigationManager


<div class="layout-container">
    <div class="layout-image-container">
        <img src="/images/CLT logo white.png" alt="CLT Logo" class="layout-logo" />
    </div>

    <div class="logout-message">
        <h3 class="text-center">Logout</h3>
        <p>You have successfully logged out.</p>
        <p>Thank you for using our service!</p>
        <p>Shutting Down...</p>
    </div>
</div>

<style>
    .p-4 {
        max-width: 400px;
        margin: 50px auto;
        background: #49269a;
        color: white;
        text-align: center;
    }

    .create-account {
        background-color: #694ab0;
    }

    hover .create-account {
        background: #8477a3;
        border: rgb(white, blue, #bf00ff);
    }
</style>
