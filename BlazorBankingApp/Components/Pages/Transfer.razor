<!--
    This page allows users to send money to other users or transfer money between their own accounts.
    It includes input fields for the recipient's email and the amount to be transferred.
    The page also provides a dropdown for selecting the target account for internal transfers.
    The page handles validation and displays success or error messages based on the transfer status.
-->

@page "/transfer"
@rendermode InteractiveServer
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager Navigation
@inject DataService DataService
@inject TransactionsService TransactionsService
@using Supabase;
@using Supabase.Postgrest.Models;
@using static Supabase.Postgrest.Constants;
@using Supabase.Postgrest.Extensions;
@using BlazorBankingApp.Service;
@using System.ComponentModel.DataAnnotations;


<PageTitle>Transfer</PageTitle>
<div class="transfer-page-background">
    <div class="transfer-container">
        <p> <strong class="transfer-label">Transfer Money</strong></p>
        <EditForm Model="@transferModel" OnValidSubmit="@HandleTransfer">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="receiverEmail" class="form-label">Recipient Email</label>
                <InputText id="receiverEmail" class="form-control" @bind-Value="transferModel.ReceiverEmail" />
            </div>

            <div class="mb-3">
                <label for="amount" class="form-label">Amount</label>
                <InputNumber id="amount" class="form-control" @bind-Value="transferModel.Amount" />
            </div>

            <button type="submit" class="btn btn-primary">Send Money</button>
        </EditForm>

        @if (!string.IsNullOrEmpty(statusMessage))
        {
            <div class="alert alert-info mt-3">@statusMessage</div>
        }
    </div>

    <div class="transfer-container">
        <p> <strong class="transfer-label">Transfer Money Between Accounts</strong></p>
        <EditForm Model="@internalTransfer" OnValidSubmit="@HandleInternalTransfer">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label for="targetAccount">Transfer To</label>
                <InputSelect id="targetAccount" class="form-control" @bind-Value="internalTransfer.TargetAccountId">
                    @foreach (var acc in UserAccounts.Where(a => a.Id != UserService.CurrentAccountId))
                    {
                        <option value="@acc.Id">@acc.Name (@acc.Type)</option>
                    }
                </InputSelect>
            </div>

            <div class="mb-3">
                <label for="internalAmount">Amount</label>
                <InputNumber id="internalAmount" class="form-control" @bind-Value="internalTransfer.Amount" />
            </div>

            <button type="submit" class="btn btn-success">Transfer Between My Accounts</button>
        </EditForm>
        @if (!string.IsNullOrEmpty(internalStatusMessage))
        {
            <div class="alert alert-info mt-3">@internalStatusMessage</div>
        }
    </div>

</div>

@code {
    private TransferModel transferModel = new();
    private string statusMessage;
    private string internalStatusMessage;
    private List<string> AllRelevantRecipients { get; set; } = new();
    private List<string> FilteredRecipients { get; set; } = new();

    /// <summary>
    /// Handles the submission of the transfer form.
    /// </summary>
    private class InternalTransferModel
    {
        [Required]
        public Guid TargetAccountId { get; set; }

        [Required]
        [Range(0.01, double.MaxValue, ErrorMessage = "Amount must be positive.")]
        public decimal Amount { get; set; }
    }

    /// <summary>
    /// Model for internal transfer between the user's own accounts.
    /// </summary>
    private InternalTransferModel internalTransfer = new();

    /// <summary>
    /// List of accounts associated with the user.
    /// </summary>
    private List<Account> UserAccounts = new();

    /// <summary>    
    /// Fetches all users from the database when the component is initialized.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        var session = SupabaseService.GetClient().Auth.CurrentSession;
        if (session == null)
        {
            //ErrorMessage = "Please log in ";
            return;
        }
        var sentTo = await TransactionsService.GetSentEmails(Guid.Parse(session.User.Id));
        var receivedFrom = await TransactionsService.GetReceivedEmails(Guid.Parse(session.User.Id));

        AllRelevantRecipients = sentTo
        .Concat(receivedFrom)
        .Distinct()
        .ToList();

        UserAccounts = await DataService.GetUserAccounts();


    }


    /// <summary>
    /// Handles the transfer of money between users.
    /// </summary>
    private async Task HandleTransfer()
    {
        Console.WriteLine("HandleTransfer called");
        statusMessage = "";

        if (UserService.CurrentAccountId == null)
        {
            statusMessage = "No account selected.";
            Console.WriteLine(statusMessage);
            return;
        }

        try
        {
            var session = SupabaseService.GetClient().Auth.CurrentSession;
            Console.WriteLine($"Current user ID: {session?.User?.Id}");
            Console.WriteLine($"CurrentAccountId from UserService: {UserService.CurrentAccountId}");
            Console.WriteLine($"");
            var senderAccountId = UserService.CurrentAccountId.Value;
            var currentEmail = SupabaseService.GetClient().Auth.CurrentSession?.User?.Email;
            Console.WriteLine($"Sender Account ID: {senderAccountId}, Sender Email: {currentEmail}");
            

            // Look up recipient BankUser by email
            var receiverUser = await SupabaseService.FindUserByEmailAsync(transferModel.ReceiverEmail);
            Console.WriteLine($"Receiver User: {receiverUser?.Email}, Receiver User ID: {receiverUser?.Id}");
            Console.WriteLine($"Transfer Model Receiver Email: {transferModel.ReceiverEmail}");

            if (transferModel.ReceiverEmail.Trim().ToLower() == currentEmail?.Trim().ToLower())
            {
                statusMessage = "Cannot transfer to yourself.";
                Console.WriteLine(statusMessage);
                return;
            }
            if (receiverUser == null)
            {
                statusMessage = "Recipient not found.";
                return;
            }

            // Get recipient's default (checking) account
            var receiverAccountResp = await SupabaseService.GetClient()
            .From<Account>()
            .Filter("user_id", Operator.Equals, receiverUser.Id)
            .Get();

            var receiverAccount = receiverAccountResp.Models
            .FirstOrDefault(a => a.Type.ToLower() == "checking") ?? receiverAccountResp.Models.FirstOrDefault();

            if (receiverAccount == null)
            {
                statusMessage = "Recipient has no available account.";
                return;
            }

            if (receiverAccount.Id == senderAccountId)
            {
                statusMessage = "Cannot transfer to your own account.";
                Console.WriteLine(statusMessage);
                return;
            }

            // Call the account-level transaction method
            Console.WriteLine($"Attempting to send ${transferModel.Amount} from {senderAccountId} to {receiverAccount.Id}");

            var result = await TransactionsService.SendTransactionAsync(
            senderAccountId,
            receiverAccount.Id,
            transferModel.Amount
            );

            if (result == "Transaction successful!")
            {
                statusMessage = $"Transfer successful! ${transferModel.Amount} sent to {transferModel.ReceiverEmail}.";
            }

        }
        catch (Exception ex)
        {
            statusMessage = $"Error processing transfer: {ex.Message}";
            Console.WriteLine(statusMessage);
        }
    }

    /// <summary>
    /// Handles the internal transfer between the user's own accounts.
    /// </summary>
    private async Task HandleInternalTransfer()
    {
        if (UserService.CurrentAccountId == null)
        {
            internalStatusMessage = "No source account selected.";
            return;
        }

        if (internalTransfer.TargetAccountId == Guid.Empty)
        {
            internalStatusMessage = "Please select a valid destination account.";
            return;
        }

        if (UserService.CurrentAccountId == internalTransfer.TargetAccountId)
        {
            internalStatusMessage = "Cannot transfer to the same account.";
            return;
        }

        try
        {
            var result = await TransactionsService.SendTransactionAsync(
            UserService.CurrentAccountId.Value,
            internalTransfer.TargetAccountId,
            internalTransfer.Amount,
            true
            );

            internalStatusMessage = result.Contains("successful")
            ? $"Successfully transferred ${internalTransfer.Amount} between your accounts."
            : result;
        }
        catch (Exception ex)
        {
            internalStatusMessage = $"Internal transfer error: {ex.Message}";
        }
    }

    /// <summary>
    /// Filters the recipient suggestions based on the input value.
    /// </summary>
    /// <param name="e">The change event arguments.</param>
    private void FilterSuggestions(ChangeEventArgs e)
    {
        var input = e.Value?.ToString() ?? string.Empty;
        FilteredRecipients = AllRelevantRecipients
        .Where(email => email.Contains(input, StringComparison.OrdinalIgnoreCase))
        .ToList();
    }

    /// <summary>
    /// Selects a recipient from the filtered suggestions.
    /// </summary>
    /// <param name="email">The email of the selected recipient.</param>
    private void SelectRecipient(string email)
    {
        transferModel.ReceiverEmail = email;
        FilteredRecipients.Clear();
    }

    /// <summary>
    /// Model for the transfer form.
    /// </summary>
    public class TransferModel
    {
        [Required]
        public string ReceiverEmail { get; set; }

        [Required]
        [Range(0.01, double.MaxValue, ErrorMessage = "Amount must be positive.")]
        public decimal Amount { get; set; }
    }

    private string RecipientEmail { get; set; }
    private decimal Amount { get; set; }
    private string ErrorMessage { get; set; }
    private string SuccessMessage { get; set; }


}