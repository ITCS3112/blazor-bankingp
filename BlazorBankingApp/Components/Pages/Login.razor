@page "/"
@rendermode InteractiveServer
@inject Supabase.Client SupabaseClient
@inject NavigationManager NavigationManager
<div class="login-container">
    <h1 class="text-center mb-4">Welcome to Charlotte's Banking App</h1>

    <div class="card shadow p-4">
        <h3 class="text-center">Login</h3>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input @bind="email" id="email" type="email" class="form-control" placeholder="Enter your email" />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input @bind="password" id="password" type="password" class="form-control"
                placeholder="Enter your password" />
        </div>

        <button @onclick="@(() => NavigationManager.NavigateTo("/home"))">Go to Home</button>

        @if (!string.IsNullOrEmpty(loginMessage))
        {
            <div class="alert mt-3" style="color: red;">@loginMessage</div>
        }

        <div class="mt-3 text-center">
            <button style="color: white;" @onclick="@(() => NavigationManager.NavigateTo("/signup"))"
                class="create-account btn w-33">Create Account</button>
        </div>
    </div>
</div>

<style>
    .p-4 {
        max-width: 400px;
        margin: 50px auto;
        background: #49269a;
        color: white;
        text-align: center;
    }

    .create-account {
        background-color: #694ab0;
    }

    hover .create-account {
        background: #8477a3;
        border: rgb(white, blue, #bf00ff);
    }
</style>

@code {
    private string email;
    private string password;
    private string loginMessage = string.Empty;

    private async Task login()
    {
        try
        {
            var response = await SupabaseClient.Auth.SignIn(email, password);

            if (response.User != null)
            {
                loginMessage = "Login successful!";
                Console.WriteLine("User logged in: " + response.User.Email);
                Console.WriteLine("Navigating to /home...");
                NavigationManager.NavigateTo("/home");
            }
            else
            {
                loginMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            loginMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Login error: {ex.Message}");
        }
    }
}