@page "/"
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation


<pagetitle>Login</pagetitle>

<h1> Welcome To Charlotte's Banking App</h1>
<p>Login</p>
<textbox @bind="username" placeholder="Username" />
<textbox @bind="password" placeholder="Password" type="password" />
<button @onclick="login">Login</button>

<link href="SignUp.razor" aria-placeholder="Create An Account"/>


@code {
    private string email;
    private string password;
    private string loginMessage = string.Empty;

    private async Task login()
    {
        try
        {
            var response = await SupabaseClient.Auth.SignIn(email, password);

            if (response.User != null)
            {
                loginMessage = "Login successful!";
                Console.WriteLine("User logged in: " + response.User.Email);
                // Redirect to another page after login if needed
                Navigation.NavigateTo("/home");
            }
            else
            {
                loginMessage = "Invalid email or password.";
            }
        }
        catch (Exception ex)
        {
            loginMessage = $"Error: {ex.Message}";
            Console.WriteLine($"Login error: {ex.Message}");
        }
    }
}