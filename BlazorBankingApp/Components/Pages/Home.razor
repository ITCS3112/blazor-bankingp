            Console.WriteLine($"Recipient ID: {recipientId}");
            Console.WriteLine($"Amount: {amount}");
            await TransactionsService.SendTransactionAsync(senderId, recipientId, amount);
            Balance = await DataService.FetchBalance(); // Refresh balance after transfer

