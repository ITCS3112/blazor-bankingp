@page "/home"
@rendermode InteractiveServer
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager Navigation
@inject DataService DataService
@inject TransactionsService TransactionsService
@using Supabase;
@using Supabase.Postgrest.Models;
@using static Supabase.Postgrest.Constants;
@using Supabase.Postgrest.Extensions;
@using BlazorBankingApp.Service;


<PageTitle>Home</PageTitle>
<div class="home-page-background">
    <div class="balance-container">
        <p>
            <strong class="balance-label">Balance:</strong>
        </p>
        <p class="balance-amount">@Balance.ToString("C2")</p>
    </div>
    <button @onclick="TestTransfer">Send Test $1 Transfer</button>
    <div class="transaction-container">
        <p>
            <strong class="transaction-label">Transaction History:</strong>
        </p>
    </div>

    @if (IsLoading)
    {
        <p>Loading...</p>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }

</div>
@using System.Text.Json.Serialization

@code {
    private float Balance { get; set; }
    private string ID => SupabaseService.GetClient().Auth.CurrentSession?.User?.Id?.ToString() ?? string.Empty;
    private string Name {get; set; } = string.Empty;
    private bool IsLoading { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var session = SupabaseService.GetClient().Auth.CurrentSession;
        if (session == null)
        {
            ErrorMessage = "Please log in to view your balance.";
            return;
        }

        Balance = await DataService.FetchBalance();
    }

    private async Task TestTransfer() {
        try
