@page "/home"
@rendermode InteractiveServer
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager Navigation
@using Supabase;
@using Supabase.Postgrest.Models;
@using static Supabase.Postgrest.Constants;
@using Supabase.Postgrest.Extensions;


<PageTitle>Home</PageTitle>
<div class="home-page-background">
    <p>
        <strong>Balance: @(Balance.ToString("C2")) </strong>
    </p>

    @if (IsLoading)
    {
        <p>Loading...</p>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }

</div>
@using System.Text.Json.Serialization

@code {
    private float Balance { get; set; }
    private string ID => SupabaseService.GetClient().Auth.CurrentSession?.User?.Id?.ToString() ?? string.Empty;
    private bool IsLoading { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var session = SupabaseService.GetClient().Auth.CurrentSession;
        if (session == null)
        {
            ErrorMessage = "Please log in to view your balance.";
            return;
        }

        await FetchBalance();
    }

    private async Task FetchBalance()
    {
        try
        {
            
            IsLoading = true;

            var session = SupabaseService.GetClient().Auth.CurrentSession;
            Console.WriteLine("Error Line 56 Home.razor");
            if (session == null)
            {
                ErrorMessage = "User session is not available. Please log in again.";
                return;
            }
            else
            {
                Console.WriteLine("Session is available.");
            }
            
            BankUser bankUser = await SupabaseService.GetClient()
                .From<BankUser>()
                .Select("balance")
                .Filter("id", Operator.Equals, SupabaseService.GetClient().Auth.CurrentSession.User.Id)
                .Single();
                
            if (bankUser == null)
            {
                ErrorMessage = "Balance not found.";
                return;
            }
            else
            {
                Balance = (float)bankUser.Balance;
            }
            
        }
        catch (Exception ex)
        {
            ErrorMessage = $"(In Home.razor) Error fetching balance: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

}
