@page "/home"
@rendermode InteractiveServer
@inject Supabase.Client SupabaseClient
@inject NavigationManager Navigation


<PageTitle>Home</PageTitle>
<div class="home-page-background">
<img src="/images/CLT logo white.png" alt="CLT Logo" class="home-page-logo" />
<h1>Welcome to the Home Page of Charlotte Banking Group</h1>


<p>Please Login or Create An account.</p>


<div class="button-container">
    <button class="btn btn-primary" @onclick="GoToLogin">Login</button>
    <button class="btn btn-primary" @onclick="GoToSignUp">Sign Up</button>
</div>
</div>
@code {
    private void GoToLogin()
    {
        Navigation.NavigateTo("/login");
    }


    private void GoToSignUp()
    {
        Navigation.NavigateTo("/signup");
    }
}

