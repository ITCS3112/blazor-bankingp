    private async Task FetchTransactions()
    {
        try
        {
            var session = SupabaseService.GetClient().Auth.CurrentSession;
            if (session == null)
            {
                ErrorMessage = "User session is not available. Please log in again.";
                return;
            }


            var userId = Guid.Parse(session.User.Id);
            if (UserService.CurrentAccountId.HasValue)
            {
                Console.WriteLine($"Fetching transactions for account ID: {UserService.CurrentAccountId.Value}");
                transactions = await TransactionsService.GetTransactionsAsync(UserService.CurrentAccountId.Value);
            }
            else
            {
                ErrorMessage = "Current account ID is not available.";
                transactions = new List<Transaction>();
            }
            if (transactions == null)
            {
                Console.WriteLine("Transactions result is null");
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error fetching transactions in Home.razor: {ex.Message}";
        }
    }
    private bool IsUserSender(Transaction transaction)
    {
        var userId = SupabaseService.GetClient().Auth.CurrentSession?.User?.Id;
        return transaction.SenderId.ToString() == userId;
    }


    private string GetTransactionClass(Transaction transaction)
    {
        return IsUserSender(transaction) ? "outgoing-transaction" : "incoming-transaction";
    }


    private string GetAmountClass(Transaction transaction)
    {
        return IsUserSender(transaction) ? "negative-amount" : "positive-amount";
    }


    private string FormatTransactionAmount(Transaction transaction)
    {
        return IsUserSender(transaction)
        ? $"-${transaction.Amount:F2}"
        : $"+${transaction.Amount:F2}";
    }


    private string GetSimplifiedId(Guid id)
    {
        // Just show first 8 characters of the ID
        return id.ToString().Substring(0, 8) + "...";
    }
    private string ConvertToEST(DateTime utcTime)
    {
        try
        {
            var estTimeZone = TimeZoneInfo.FindSystemTimeZoneById("Eastern Standard Time");
            var estTime = TimeZoneInfo.ConvertTimeFromUtc(utcTime, estTimeZone);
            return estTime.ToString("MMM dd, yyyy HH:mm"); // Format as desired
        }
        catch (TimeZoneNotFoundException)
        {
            Console.WriteLine("Eastern Standard Time zone not found.");
            return utcTime.ToString("MMM dd, yyyy HH:mm"); // Fallback to UTC
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error converting time to EST: {ex.Message}");
            return utcTime.ToString("MMM dd, yyyy HH:mm"); // Fallback to UTC
        }
    }
    private bool IsCurrentUser(Guid userId)
    {
        var currentUserId = SupabaseService.GetClient().Auth.CurrentSession?.User?.Id;
        return userId.ToString() == currentUserId;
    }

    private string GetAmountClas(Transaction transaction)
    {
        return IsCurrentUser(transaction.SenderId) ? "sent-amount" : "received-amount";
    }

    private string FormatAmount(Transaction transaction)
    {
        return IsCurrentUser(transaction.SenderId)
        ? $"-${transaction.Amount:F2}"
        : $"+${transaction.Amount:F2}";
    }


