@page "/home"
@rendermode InteractiveServer
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager Navigation
@inject DataService DataService
@inject TransactionsService TransactionsService
@using Supabase;
@using Supabase.Postgrest.Models;
@using static Supabase.Postgrest.Constants;
@using Supabase.Postgrest.Extensions;
@using BlazorBankingApp.Service;




<PageTitle>Home</PageTitle>
<div class="home-page-background">
    <div class="balance-container">
        <p>
            <strong class="balance-label">Balance:
                @if (CurrentAccount != null)
                {
                    <span>@CurrentAccount.Name</span>
                }
                else
                {
                    <span>Loading...</span>
                }
            </strong>
        </p>
        <p class="balance-amount">@Balance.ToString("C2")</p>
    </div>
    <div class="transaction-container">
        <h3 class="transaction-label">Transaction History</h3>
        @if (transactions == null || !transactions.Any())
        {
            <p>No transactions found.</p>
        }
        else
        {
            <ul class="transaction-list">
                @foreach (var transaction in transactions)
                {
                    <li class="transaction-item">
                        <div class="transaction-header">
                            <span class="transaction-date">@transaction.Timestamp.ToString("MMM dd, yyyy HH:mm")</span>
                            <span class="transaction-amount @GetAmountClas(transaction)">
                                @FormatAmount(transaction)
                            </span>
                        </div>
                        <div class="transaction-details">
                            @if (IsCurrentUser(transaction.SenderId))
                            {
                                <p class="transaction-sent">You sent <span class="amount">@transaction.Amount.ToString("C2")</span>
                                    to <span class="user-name">@transaction.ReceiverName</span></p>
                            }
                            else
                            {
                                <p class="transaction-received">You received <span
                                        class="amount">@transaction.Amount.ToString("C2")</span> from <span
                                        class="user-name">@transaction.SenderName</span></p>
                            }
                        </div>
                    </li>
                }
            </ul>
        }
    </div>


    @if (IsLoading)
    {
        <p>Loading...</p>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }


</div>
@using System.Text.Json.Serialization


