<!-- 
    This page is responsible for the sign-up functionality of the application.
    It allows users to create new accounts by providing their email, password, and confirmed password.
    a user can become a admin by entering the admin ID (4321) in the admin ID field.
    The page also includes validation for the password and confirmed password fields.
    If the passwords do not match, an error message is displayed.
-->

@page "/signup/"

@rendermode InteractiveServer
@using Supabase
@using Npgsql
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager NavigationManager

<PageTitle>Sign Up</PageTitle>

<div class="layout-container">
    <div class="layout-image-container">
        <img src="/images/CLT logo white.png" alt="CLT Logo" class="layout-logo" />
    </div>

    <div class="card shadow p-4">
        <h3 class="text-center">Sign Up</h3>

        <div class="mb-3">
            <label for="email" class="form-label">Email</label>
            <input @bind="email" id="email" type="email" class="form-control" placeholder="Enter your email" />
        </div>

        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input @bind="password" id="password" type="password" class="form-control"
                placeholder="Enter your password" />
        </div>

        <div class="mb-3">
            <label for="confirmedpass" class="form-label">Confirm Password</label>
            <input @bind="confirmedpass" id="confirmedpass" type="password" class="form-control"
                placeholder="Enter your Password again" />
        </div>


        @if (!string.IsNullOrEmpty(password) && !string.IsNullOrEmpty(confirmedpass) && password != confirmedpass)
        {
            <div class="alert mt-3" style="color: red;">Passwords do not match.</div>
        }

        <div class="mb-3">
            <label for="firstname" class="form-label">Firstname</label>
            <input @bind="firstname" id="firstname" type="text" class="form-control"
                placeholder="Enter your firstname" />
        </div>

        <div class="mb-3">
            <label for="lastname" class="form-label">Lastname</label>
            <input @bind="lastname" id="lastname" type="text" class="form-control" placeholder="Enter your lastname" />
        </div>

        <div class="mb-3">
            <label for="phone" class="form-label">Phone Number</label>
            <input @bind="phone" id="phone" type="text" class="form-control" placeholder="Enter your phone number" />
        </div>

        <div class="mb-3">
            <label for="adminID" class="form-label">Admin ID</label>
            <input @bind="adminID" id="adminID" type="text" class="form-control" placeholder="Enter your admin ID" />
        </div>

        <button @onclick="signUp" class="btn btn-primary w-100">Create Account</button>

        @if (!string.IsNullOrEmpty(signUpMessage))
        {
            <div class="alert mt-3" style="color: red;">@signUpMessage</div>
        }
    </div>
</div>

<style>
    .p-4 {
        max-width: 400px;
    using Microsoft.VisualBasic;
    using BankingSystem;
        using System.Diagnostics.CodeAnalysis;
        margin: 50px auto;
        background: #49269a;
        color: white;
        text-align: center;
    }

    .create-account {
        background-color: #694ab0;
    }

    hover .create-account {
        background: #8477a3;
        border: rgb(white, blue, #bf00ff);
    }

    .layout-container {
        size: 75%;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }
</style>

@code
{
    private string email;
    private string password;
    private string confirmedpass;
    private string firstname;
    private string lastname;
    private string displayname;
    private string phone;
    private string signUpMessage = string.Empty;
    private int adminID;
    private bool isAdmin = false;
    private bool success;


    /// <summary>
    /// This method is called when the user clicks the "Create Account" button.
    /// </summary>
    private async Task signUp()
    {

        try
        {
            
            // Set display name
            displayname = $"{firstname} {lastname}";

            // Validate input for password
            if (password != confirmedpass)
            {
                signUpMessage = "Passwords do not match.";
                return;
            }
            if (password.Length < 6)
            {
                signUpMessage = "Password must be at least 6 characters long.";
                return;
            }

            // Create user
            var user = (Supabase.Gotrue.User?) null;

            //Signs up an admin if the adminID is 4321 and user else wise
            if (adminID == 4321)
            {
                isAdmin = true;
                user = await SupabaseService.SignUpUser(email, password, displayname, phone, "admin");
                Console.WriteLine($"Admin created: {user?.Email}");

            } // Signs up a user if the adminID is not 4321
            else if (adminID != 4321)
            {
                isAdmin = false;
                user = await SupabaseService.SignUpUser(email, password, displayname, phone, "user");
                Console.WriteLine($"User created: {user?.Email}");

            }
            else
            {
                user = null;
                signUpMessage = "Sign up failed. Please try again.";
                return;
            }
            
            // Check if user is created successfully
            if (user != null)
            {
                var currentSession = await SupabaseService.GetClient().Auth.SignIn(email, password);
                success = true;
                signUpMessage = "Sign up successful! Loading...";
            }
            else
            {
                signUpMessage = "Sign up failed. Please try again.";
                return;
            }
        }
        catch (Exception ex)
        {
            signUpMessage = "An error occurred during sign up. Please try again.";
            Console.WriteLine($"Sign up error: {ex.Message}");
            return;
        }
        // Redirect to home page after successful sign up
        if (success)
        {
            NavigationManager.NavigateTo("/home", true);
        }
    }
}
