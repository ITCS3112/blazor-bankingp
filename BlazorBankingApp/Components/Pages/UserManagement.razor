                throw new InvalidOperationException("User session is not available. Please log in again. - UserManagement.razor.cs");
            }

            displayName = $"{FirstName} {LastName}";

            var user = await SupabaseService.SignUpUser(Email, Password, displayName, Phone, AuthorityLevel);

            if (user != null)
            {
                Console.WriteLine($"User created: {user.Email} - UserManagement.razor.cs");
                await FetchUsers();
            }
            else
            {
                ErrorMessage = "Failed to create user. - UserManagement.razor.cs";
                Console.WriteLine(ErrorMessage);
            }

        }
        catch (Exception ex)
        {
            ErrorMessage = ex.Message;
        }
    }

