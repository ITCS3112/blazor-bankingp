@inject NavigationManager Navigation
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject DataService DataService
@inject TransactionsService TransactionsService
@using Supabase;
@using Supabase.Postgrest.Models;
@using static Supabase.Postgrest.Constants;
@using Supabase.Postgrest.Extensions;
@using BlazorBankingApp.Service;
@rendermode InteractiveServer

@page "/manageUsers"

<div class="user-container">
    <h1>Manage Users</h1>

    <!-- Search Bar -->
    <div class="search-bar">
        <input type="text" placeholder="Search by email..." @bind-value="SearchTerm" @bind-value:event="oninput"
            class="search-input" />
        <button class="btn btn-primary search-button" @onclick="PerformSearch">Search</button>
    </div>
    <div class="add-user">
        <p>Add User</p>
        <input type="text" placeholder="First Name" @bind="FirstName" class="add-user-input" />
        <input type="text" placeholder="Last Name" @bind="LastName" class="add-user-input" />
        <input type="text" placeholder="Email" @bind="Email" class="add-user-input" />
        <input type="text" placeholder="Password" @bind="Password" class="add-user-input" />
        <input type="text" placeholder="Phone" @bind="Phone" class="add-user-input" />
        <input type="text" placeholder="Authority Level" @bind="AuthorityLevel" class="add-user-input" />

        <button class="btn btn-primary add-user-button" @onclick="AddUser">Add User</button>

        @if (!string.IsNullOrEmpty(success))
        {
            <p style="color: green; font-weight: bold;">@success</p>
        }
        @if (!string.IsNullOrEmpty(ErrorMessage))
        {
            <p style="color: red; font-weight: bold;">@ErrorMessage</p>
        }
    </div>

    <!--<div class="delete-user">
        <p>Delete User</p>
        <input type="text" placeholder="Email of User to Delete" id="DeleteEmail" class="delete-user-input" />
        <button class="btn btn-danger delete-user-button" @onclick="DeleteUser">Delete User</button>
    </div>-->

    <div class="users-container">
        <h3 class="user-label">User List</h3>
        @if (FilteredUsers == null || !FilteredUsers.Any())
        {
            <p>No Users Found.</p>
        }
        else
        {
            <table class="user-table">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Authority Level</th>
                        <th>Phone</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in FilteredUsers)
                    {
                        <tr>
                            <td>@user.Name</td>
                            <td>@user.Email</td>
                            <td>@user.AuthorityLevel</td>
                            <td>@user.Phone</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
    </div>

    @if (IsLoading)
    {
        <p>Loading...</p>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }
</div>




