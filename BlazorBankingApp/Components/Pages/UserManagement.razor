    public async Task<List<BankUser>> FetchUsers()
    {
        try
        {
            var session = SupabaseService.GetClient().Auth.CurrentSession;
            if (session == null)
            {
                throw new InvalidOperationException("User session is not available. Please log in again. - UserManagement.razor.cs");
            }

            var users = await SupabaseService.GetClient()
            .From<BankUser>()
            .Select("*")
            .Get();

            if (users == null || !users.Models.Any())
            {
                Console.WriteLine("No users found in the database. - UserManagement.razor.cs");
                return new List<BankUser>();
            }
            else
            {
                Console.WriteLine($"Loaded {users.Models.Count} users. - UserManagement.razor.cs");
            }
            return users.Models;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching users: {ex.Message} - UserManagement.razor.cs");
            throw;
        }
    }

    public async Task PerformSearch()
    {
        Console.WriteLine($"PerformSearch called with SearchTerm: {SearchTerm} - UserManagement.razor.cs");

        if (users == null)
        {
            FilteredUsers = new List<BankUser>();
            ErrorMessage = "No users available to search. - UserManagement.razor.cs";
            Console.WriteLine(ErrorMessage);
            return;
        }

        if (string.IsNullOrWhiteSpace(SearchTerm))
        {
            // If the search term is empty, show all users
            FilteredUsers = users;
            ErrorMessage = string.Empty;
            Console.WriteLine("Search term is empty. Showing all users.- UserManagement.razor.cs");
        }
        else
        {
            // Filter users based on the search term
            FilteredUsers = users
            .Where(user => user.Email.Contains(SearchTerm, StringComparison.OrdinalIgnoreCase))
            .ToList();

            if (FilteredUsers.Count == 0)
            {
                Console.WriteLine($"Filtered users count: {FilteredUsers.Count} - UserManagement.razor.cs");
                ErrorMessage = "No users found matching the search term.";
                Console.WriteLine(ErrorMessage);
            }
            else
            {
                ErrorMessage = string.Empty;
                Console.WriteLine($"Found {FilteredUsers.Count} users matching the search term. - UserManagement.razor.cs");
            }
        }
        StateHasChanged();
        Console.WriteLine($"PerformSearch called with SearchTerm: {SearchTerm} - UserManagement.razor.cs");
    }


