<!-- 
    This page is for resetting the password of a user.
    It allows the user to enter their email and new password.
    **IMPORTANT**: The password reset functionality is not fully implemented yet.
    The page is set up for future development.
-->

@page "/reset_password/"

@rendermode InteractiveServer
@using Supabase
@using Npgsql
@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager NavigationManager

<PageTitle>Change Password</PageTitle>

<div class="layout-container">
    <div class="layout-image-container">
        <img src="/images/CLT logo white.png" alt="CLT Logo" class="layout-logo" />
    </div>

    <div class="card shadow p-4">
        <h3 class="text-center">Create New Password</h3>

        <div class=" mb-3">
            <label for="email" class="form-label">Email</label>
            <input @bind="UserService.email" id="email" type="email" class="form-control" placeholder="Enter your email"
                readonly />
        </div>
        <div class="mb-3">
            <label for="password" class="form-label">Password</label>
            <input @bind="password" id="password" type="password" class="form-control"
                placeholder="Enter your password" />
        </div>

        <div class="mb-3">
            <label for="confirmedpass" class="form-label">Confirm Password</label>
            <input @bind="confirmedpass" id="confirmedpass" type="password" class="form-control"
                placeholder="Enter your Password again" />
        </div>


        @if (!string.IsNullOrEmpty(password) && !string.IsNullOrEmpty(confirmedpass) && password != confirmedpass)
        {
            <div class="alert mt-3" style="color: red;">Passwords do not match.</div>
        }

        <button @onclick="resetPassword" class="btn btn-primary w-100">Set New Password</button>

        @if (!string.IsNullOrEmpty(resetMessage))
        {
            <div class="alert mt-3" style="color: red;">@resetMessage</div>
        }
    </div>
</div>

<style>
    .p-4 {
        max-width: 400px;
        margin: 50px auto;
        background: #49269a;
        color: white;
        text-align: center;
    }

    .create-account {
        background-color: #694ab0;
    }

    hover .create-account {
        background: #8477a3;
        border: rgb(white, blue, #bf00ff);
    }

    .layout-container {
        size: 75%;
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
    }
</style>


