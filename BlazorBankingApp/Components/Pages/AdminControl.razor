@page "/admin"

@inject NavigationManager Navigation
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@using Service
@inject DataService DataService
@inject TransactionsService TransactionsService
@using Supabase;
@using Supabase.Postgrest.Models;
@using static Supabase.Postgrest.Constants;
@using Supabase.Postgrest.Extensions;
@using BlazorBankingApp.Service;



<PageTitle>Admin Control</PageTitle>
<h1>Admin Control</h1>

<div class="admin-control-background">

    <a href="/manageUsers">Manage Users</a>
    <br>
    <a href="/manageTransactions">Manage Transactions</a>

    @if (IsLoading)
    {
        <p>Loading...</p>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }
</div>

<style>
    .admin-control-background {
        background-color: #f5f5f5;
        padding: 20px;
        border-radius: 5px;
        box-shadow: 0 2px 5px rgba(0, 0, 0, 0.1);
        display: flex;
        flex-direction: row;
        align-items: center;
        justify-content: center;
        gap: 20px;
    }

    
</style>


@code
{
    private bool IsLoading = false;
    private string ErrorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var session = SupabaseService.GetClient().Auth.CurrentSession;
        if (session == null)
        {
            ErrorMessage = "Please log in to view your balance.";
            return;
        }
    }

    private void NavigateToManageUsers()
    {
        Navigation.NavigateTo("/manageusers");
    }
    private void NavigateToManageTransactions()
    {
        Navigation.NavigateTo("/manageTransactions");
    }
}