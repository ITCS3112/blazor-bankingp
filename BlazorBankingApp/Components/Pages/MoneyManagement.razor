<!-- 
    This file is for managing money transactions in a banking application.
    It allows users to deposit or withdraw a entered amount of money from their accounts.
-->


@page "/management"

@rendermode InteractiveServer
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@inject NavigationManager Navigation
@inject DataService DataService
@using Supabase
@using Supabase.Postgrest.Models
@using static Supabase.Postgrest.Constants
@using Supabase.Postgrest.Extensions
@using BlazorBankingApp.Service
@using System

<PageTitle>Deposit/Withdraw</PageTitle>

<div class="money-management-background">
    <h1>Deposit or Withdraw From Your Account</h1>

    @if (IsLoading)
    {
        <p>Loading...</p>
    }
    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <p style="color: red;">@ErrorMessage</p>
    }

    <div class="balance-container">
        <p>
            <strong class="balance-label">Current Balance:</strong>
        </p>
        <p class="balance-amount">@Balance.ToString("C2")</p>
    </div>

    <div class="transaction-controls">
        <div class="transaction-input">
            <label for="transaction-amount">Amount:</label>
            <input id="transaction-amount" type="number" step="0.01" @bind="TransactionAmount" />
        </div>
        <div class="transaction-buttons">
            <button class="btn btn-success" @onclick="DepositMoney">Deposit</button>
            <button class="btn btn-danger" @onclick="WithdrawMoney">Withdraw</button>
        </div>
    </div>
</div>

<style>
    .money-management-background {
        background-color: #f5f5f5;
        padding: 20px;
        border-radius: 8px;
        margin: 20px;
    }

    .balance-container {
        margin-bottom: 20px;
    }

    .balance-label {
        font-weight: bold;
    }

    .balance-amount {
        font-size: 24px;
        color: green;
    }

    .transaction-controls {
        margin-top: 20px;
    }

    .transaction-input {
        margin-bottom: 10px;
    }

    .transaction-buttons button {
        font-size: 16px;
        padding: 10px;
        margin-top: 10px;
    }

    .btn-success {
        background-color: #28a745;
        color: white;
        border: none;
    }

    .btn-danger {
        background-color: #dc3545;
        color: white;
        border: none;
    }
</style>

@code {
    private decimal Balance { get; set; }
    private decimal TransactionAmount { get; set; }
    private bool IsLoading { get; set; }
    private string ErrorMessage { get; set; } = string.Empty;

    /// <summary>
    /// This method is called when the component is initialized.
    /// It retrieves the current account balance and sets it to the Balance property.
    /// </summary>
    protected override Task OnInitializedAsync()
    {
        var account = UserService.CurrentAccount;

        if (account == null)
        {
            ErrorMessage = "No current account found. Please log in.";
        }
        else
        {
            Balance = account.Balance;
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// This method is called when the user clicks the Deposit button.
    /// It validates the input amount and calls the DataService to add the amount to the balance.
    /// </summary>
    private async Task DepositMoney()
    {
        if (TransactionAmount <= 0)
        {
            ErrorMessage = "Please enter a valid deposit amount.";
            return;
        }

        try
        {
            IsLoading = true;

            bool success = await DataService.AddToBalance((float)TransactionAmount);
            if (success)
            {
                Balance += TransactionAmount;
                ErrorMessage = string.Empty;
            }
            else
            {
                ErrorMessage = "Deposit failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error during deposit: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }

    /// <summary>
    /// This method is called when the user clicks the Withdraw button.
    /// It validates the input amount and calls the DataService to subtract the amount from the balance.
    /// </summary>
    private async Task WithdrawMoney()
    {
        if (TransactionAmount <= 0)
        {
            ErrorMessage = "Please enter a valid withdrawal amount.";
            return;
        }

        if (TransactionAmount > Balance)
        {
            ErrorMessage = "Insufficient funds.";
            return;
        }

        try
        {
            IsLoading = true;

            bool success = await DataService.AddToBalance(-(float)TransactionAmount);
            if (success)
            {
                Balance -= TransactionAmount;
                ErrorMessage = string.Empty;
            }
            else
            {
                ErrorMessage = "Withdrawal failed. Please try again.";
            }
        }
        catch (Exception ex)
        {
            ErrorMessage = $"Error during withdrawal: {ex.Message}";
        }
        finally
        {
            IsLoading = false;
        }
    }
}
