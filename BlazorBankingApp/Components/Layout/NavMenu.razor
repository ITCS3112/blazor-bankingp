@inject Services.SupabaseService SupabaseService
@inject Service.DataService DataService
@inject Services.UserService UserService
@using BlazorBankingApp.Service


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">CLT Banking</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill-nav-menu" aria-hidden="true"></span> Home
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="accounts">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Accounts
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="transfer">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Transfer
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="loan">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Loans
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="family">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Family
            </NavLink>
        </div>

        <div class="nav-item px-3">
            <NavLink class="nav-link" href="management">
                <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Money Management
            </NavLink>
        </div>

        @if(IsAdmin){
            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin">
                    <span class="bi bi-plus-square-fill-nav-menu" aria-hidden="true"></span> Admin Control
                </NavLink>
            </div>
        }

        </nav>
</div>

@code{
    private bool IsAdmin { get; set; } = false;

    protected override async Task OnInitializedAsync(){
        try{
            var authority = await DataService.FetchAuthority();
            if(authority == "admin"){
                IsAdmin = true;
            }
            else{
                IsAdmin = false;
            }
        }
        catch(Exception ex){
            Console.WriteLine($"Error checking if admin: {ex.Message} - NavMenu.OnInitializedAsync");
            IsAdmin = false;
        }
    }
}

