@inject Services.SupabaseService SupabaseService
@inject Service.DataService DataService
@inject Services.UserService UserService
@using BlazorBankingApp.Service


<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="home">CLT Banking</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
    <NavLink class="nav-link" href="home" Match="NavLinkMatch.All">
        <i class="bi bi-house-door-fill" aria-hidden="true"></i> Home
    </NavLink>
</div>

<div class="nav-item px-3">
    <NavLink class="nav-link" href="accounts">
        <i class="bi bi-wallet2" aria-hidden="true"></i> Accounts
    </NavLink>
</div>

<div class="nav-item px-3">
    <NavLink class="nav-link" href="management">
        <i class="bi bi-cash" aria-hidden="true"></i> Deposit/Withdraw
    </NavLink>
</div>

<div class="nav-item px-3">
    <NavLink class="nav-link" href="transfer">
        <i class="bi bi-arrow-left-right" aria-hidden="true"></i> Transfer
    </NavLink>
</div>

<div class="nav-item px-3">
    <NavLink class="nav-link" href="loan">
        <i class="bi bi-cash-stack" aria-hidden="true"></i> Loans
    </NavLink>
</div>


@if (IsAdmin)
{
    <div class="nav-item px-3">
        <NavLink class="nav-link" href="admin">
            <i class="bi bi-shield-lock-fill" aria-hidden="true"></i> Admin Control
        </NavLink>
    </div>
}


        </nav>
</div>

@code{
    private bool IsAdmin { get; set; } = false;

    protected override async Task OnInitializedAsync(){
        try{
            var authority = await DataService.FetchAuthority();
            if(authority == "admin"){
                IsAdmin = true;
            }
            else{
                IsAdmin = false;
            }
        }
        catch(Exception ex){
            Console.WriteLine($"Error checking if admin: {ex.Message} - NavMenu.OnInitializedAsync");
            IsAdmin = false;
        }
    }
}

