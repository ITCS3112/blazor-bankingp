@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Services.SupabaseService SupabaseService
@inject Services.UserService UserService
@using BlazorBankingApp.Services

<div class="page">
    <div class="sidebar @(IsHomePage ? "no-background" : "")">
        @if (!IsHomePage) {
            <NavMenu />
        }

    </div>

    <main>
        @if (!IsHomePage) {
            <div class="top-row px-4">
                @if (!string.IsNullOrEmpty(Email)) {
                    <span class="username">Welcome, @Name</span>
                }
                <a href="/logout" target="_blank">Logout</a>
                <a href="/about" target="_blank">About</a>
            </div>

            <div class="layout-image-container">
                <img src="/images/CLT logo white.png" alt="CLT Logo" class="layout-logo" />
            </div>
        }
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    private bool IsHomePage => Navigation.Uri.EndsWith("/");

    private string Email => SupabaseService.GetClient().Auth.CurrentSession?.User?.Email?.ToString() ?? string.Empty;
    private string Name => UserService.GetUserName() ?? "Error Loading Name - MainLayout.razor";
}
