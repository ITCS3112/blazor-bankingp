<!-- 
    This page is used to set a basic page layout for any page thats page does not end with /.
    It is used to set the sidebar and the top row of the page.
-->



@inherits LayoutComponentBase
@inject NavigationManager Navigation
@inject Services.SupabaseService SupabaseService
@inject DataService DataService
@using BlazorBankingApp.Service

<div class="page">
    <div class="sidebar @(IsHomePage ? "no-background" : "")">
        @if (!IsHomePage)
        {
            <NavMenu />
        }

    </div>

    <main>
        @if (!IsHomePage)
        {
            <div class="top-row px-4">
                <div class="name">
                    @if (string.IsNullOrEmpty(Name))
                    {
                        <span class="name">Welcome, Guest</span>
                    }
                    else
                    {
                        <span class="name">Welcome, @Name</span>
                    }
                </div>

                <div class="top-row-buttons">
                    <a href="#" @onclick="Logout" class="btn-link">Logout</a>
                    <a href="/about" target="_blank" class="btn-link">About</a>
                    
                </div>
            </div>


        }
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>


@code {
    private bool IsHomePage => Navigation.Uri.EndsWith("/");

    private string Email => SupabaseService.GetClient().Auth.CurrentSession?.User?.Email?.ToString() ?? string.Empty;
    private string Name { get; set; } = "Name not found";


    /// <summary>
    /// This method is called when the component is initialized.
    /// It retrieves the current user's name and sets it to the Name property.
    /// </summary>
    protected override async Task OnInitializedAsync()
    {
        try
        {
            Name = await DataService.FetchName();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error fetching name: {ex.Message}");
            Name = "Error fetching name";
            StateHasChanged();
        }
    }


    /// <summary>
    /// This method is called when the user clicks the logout button.
    /// It signs out the user and navigates to the login page.
    /// </summary>
    private async Task Logout()
    {
        try
        {
            await SupabaseService.GetClient().Auth.SignOut();
            Navigation.NavigateTo("/login", true);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error during logout: {ex.Message}");
        }
    }
}