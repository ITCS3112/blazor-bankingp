@inherits LayoutComponentBase
@inject NavigationManager Navigation

<div class="page">
    <div class="sidebar @(IsHomePage ? "no-background" : "")">
        @if (!IsHomePage) {
            <NavMenu />
        }

    </div>

    <main>
        @if (!IsHomePage) {
            <div class="top-row px-4">
                <a href="https://learn.microsoft.com/aspnet/core/" target="_blank">Logout</a>
                <a href="/about" target="_blank">About</a>
            </div>

            <div class="layout-image-container">
                <img src="/images/CLT logo white.png" alt="CLT Logo" class="layout-logo" />
            </div>
        }
        <article class="content px-4">
            @Body
        </article>
    </main>
</div>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>
@code {
    private bool IsHomePage => Navigation.Uri.EndsWith("/");
}